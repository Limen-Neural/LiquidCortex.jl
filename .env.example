# LiquidCortex local environment variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is listed in .gitignore.

# Sentry — used by sentry-cli for local release management
# Generate at: https://limen-neural.sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=

# Sentry org and project (defaults match CI workflow values)
SENTRY_ORG=limen-neural
SENTRY_PROJECT=liquidcortex